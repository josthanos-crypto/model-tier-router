{
  "name": "model-tier-router",
  "version": "1.0.0",
  "private": true,
  "description": "The right Claude model and effort for every task, with a self-updating model catalog. Claude Code plugin.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "scripts": {
    "test": "node --test \"tests/**/*.test.mjs\"",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"scripts/**\" --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=80 \"tests/**/*.test.mjs\"",
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "update-models": "node scripts/update-models.mjs"
  }
}
